{
  "name": "aether-ui-core",
  "version": "1.0.7",
  "description": "UI library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --config jest.config.ts --silent"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoffreyschmitt/aetherUiCore.git"
  },
  "author": "Geoffrey Schmitt",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/geoffreyschmitt/aetherUiCore/issues"
  },
  "homepage": "https://github.com/geoffreyschmitt/aetherUiCore#readme",
  "dependencies": {
    "styled-components": "^6.1.13",
    "typescript": "^5.6.2"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./components/*": {
      "import": "./dist/components/*",
      "types": "./dist/components/*"
    },
    "./eventChannels/*": {
      "import": "./dist/eventChannels/*",
      "types": "./dist/eventChannels/*"
    },
    "./GlobalStyles/*": {
      "import": "./dist/GlobalStyles/*",
      "types": "./dist/GlobalStyles/*"
    },
    "./hooks/*": {
      "import": "./dist/hooks/*",
      "types": "./dist/hooks/*"
    },
    "./utils/*": {
      "import": "./dist/utils/*",
      "types": "./dist/utils/*"
    }
  }
}